{
  "apps": [
    {
      "name": "Colony",
      "about": "The colony's work: a turtle's job, or a computer watching a Create Radar",
      "run": "main.lua",
      "on": [
        "turtle",
        "computer"
      ],
      "autostart": true,
      "files": [
        "main.lua",
        "web.lua",
        "setweb.lua",
        "orders.lua",
        "role.lua",
        "world.lua",
        "position.lua",
        "move.lua",
        "turn.lua",
        "terrain.lua",
        "sightings.lua",
        "worldmap.lua",
        "nogo.lua",
        "pathfind.lua",
        "nav.lua",
        "travel.lua",
        "mining.lua",
        "build.lua",
        "warehouse.lua",
        "quarry.lua",
        "well.lua",
        "dig.lua",
        "scanner.lua",
        "forester.lua",
        "gatherer.lua",
        "smelt.lua",
        "radar.lua",
        "craft.lua",
        "recipes.lua",
        "locate.lua",
        "equipment.lua",
        "setup.lua",
        "area.lua",
        "woodcutter.lua",
        "chat.lua",
        "nojob.lua",
        "remote.lua",
        "players.lua"
      ]
    },
    {
      "name": "Info",
      "about": "What's what on this device: release, job, position, fuel, disk, tracker, last crash",
      "run": "info.lua",
      "on": [
        "turtle",
        "computer",
        "pocket"
      ],
      "files": [
        "info.lua"
      ]
    },
    {
      "name": "Pause work",
      "about": "Stop the turtle's work before its next move, and let it carry on again",
      "run": "pause.lua",
      "on": [
        "turtle"
      ],
      "files": [
        "pause.lua"
      ]
    },
    {
      "name": "Set position",
      "about": "Forget where the turtle is and work it out again (asks you)",
      "run": "setpos.lua",
      "on": [
        "turtle"
      ],
      "files": [
        "setpos.lua"
      ]
    },
    {
      "name": "Settings",
      "about": "The tracker's address and key, the world, the name, the job",
      "run": "options.lua",
      "on": [
        "turtle",
        "computer"
      ],
      "files": [
        "options.lua"
      ]
    },
    {
      "name": "FindPlayer",
      "about": "Pick an online player and watch where they are",
      "run": "FindPlayer.lua",
      "on": [
        "turtle",
        "computer",
        "pocket"
      ],
      "needs": [
        "playerDetector"
      ],
      "files": [
        "FindPlayer.lua"
      ]
    }
  ]
}
